{
  "manifest_version": 3,
  "name": "GradWiser for arXiv",
  "description": "Open arXiv papers directly in GradWiser, with English or Chinese selected from your browser language.",
  "version": "0.1.0",
  "content_scripts": [
    {
      "matches": [
        "https://arxiv.org/abs/*",
        "https://www.arxiv.org/abs/*",
        "https://www.google.com/search*"
      ],
      "js": ["src/paper-link.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
